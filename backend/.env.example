# Copiá este archivo como .env y completá los valores.

# Base de datos. Por defecto usa SQLite (no hace falta instalar nada).
# Para PostgreSQL (stack del proyecto), creá la base "gotrain" y descomentá:
# DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@localhost:5432/gotrain
DATABASE_URL=sqlite:///gotrain.db

# Clave para firmar los tokens de sesión (cambiala por cualquier texto largo)
SECRET_KEY=cambiar-esta-clave-secreta

# Coach IA (Claude API). Si no la ponés, el coach responde en "modo demo"
# con rutinas generadas a partir de tu historial.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
