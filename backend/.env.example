# Copiá este archivo como .env y completá los valores.

# Base de datos PostgreSQL (la base "gotrain" se crea sola con: .venv\Scripts\python crear_base.py)
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_DE_POSTGRES
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gotrain
# También se puede usar una URL completa (tiene prioridad sobre lo de arriba):
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/gotrain

# Clave para firmar los tokens de sesión (cambiala por cualquier texto largo)
SECRET_KEY=cambiar-esta-clave-secreta

# Coach IA (Claude API). Si no la ponés, el coach responde en "modo demo"
# con rutinas generadas a partir de tu historial.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
